{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "la-senda/review.schema.json",
  "title": "La Senda · Revisión",
  "description": "Contrato del JSON que produce el motor de análisis y consume el renderizador. Todos los textos son texto plano. Formato en línea permitido: `código` con comillas invertidas y **negrita** con dobles asteriscos. Nunca HTML.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "meta", "focuses", "flashcards", "quiz", "scenarios"],
  "properties": {
    "schemaVersion": {
      "description": "1.1 añade el bloque opcional study. Las revisiones 1.0 siguen siendo válidas.",
      "enum": ["1.0", "1.1"]
    },
    "meta": { "$ref": "#/$defs/meta" },
    "study": {
      "description": "Fase de estudio («El camino del Aprendiz»): explica cómo funciona el cambio antes de evaluarlo. Opcional.",
      "$ref": "#/$defs/study"
    },
    "focuses": {
      "description": "Puntos que merecen criterio humano. Toda pregunta se deriva de al menos uno.",
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": { "$ref": "#/$defs/focus" }
    },
    "flashcards": {
      "description": "Nivel 01.",
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": { "$ref": "#/$defs/flashcard" }
    },
    "quiz": {
      "description": "Nivel 02.",
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/quizItem" }
    },
    "scenarios": {
      "description": "Nivel 03.",
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": { "$ref": "#/$defs/scenario" }
    }
  },
  "$defs": {
    "label": { "type": "string", "pattern": "\\S", "maxLength": 120 },
    "shortText": { "type": "string", "pattern": "\\S", "maxLength": 300 },
    "text": { "type": "string", "pattern": "\\S", "maxLength": 600 },
    "longText": { "type": "string", "pattern": "\\S", "maxLength": 1200 },
    "sha": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
    "relativePath": {
      "description": "Ruta relativa a la raíz del repositorio. Sin '/' inicial, sin unidades de Windows y sin segmentos '..'.",
      "type": "string",
      "maxLength": 300,
      "pattern": "^(?![/\\\\])(?![A-Za-z]:)(?!.*(^|[/\\\\])\\.\\.([/\\\\]|$))\\S.*$"
    },
    "focusRefs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^F[0-9]+$" }
    },

    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewId", "project", "title", "summary", "generatedAt", "source"],
      "properties": {
        "reviewId": {
          "description": "Identificador estable de la revisión. Se usa como clave para guardar el progreso en el navegador.",
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]{1,120}$"
        },
        "project": { "$ref": "#/$defs/label" },
        "title": { "$ref": "#/$defs/label" },
        "missionName": {
          "description": "Nombre narrativo de la misión, p. ej. «Valle de la Autenticación». Si falta, se usa title.",
          "type": "string",
          "pattern": "\\S",
          "maxLength": 60
        },
        "summary": { "$ref": "#/$defs/text" },
        "generatedAt": { "type": "string", "format": "date-time" },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "base", "head", "mergeBase", "commit", "dirty"],
          "properties": {
            "type": { "enum": ["branch"] },
            "base": { "$ref": "#/$defs/label" },
            "head": { "$ref": "#/$defs/label" },
            "mergeBase": { "$ref": "#/$defs/sha" },
            "commit": { "$ref": "#/$defs/sha" },
            "dirty": {
              "description": "true si la revisión incluye cambios sin commitear.",
              "type": "boolean"
            },
            "repoUrl": {
              "description": "URL web del repositorio en GitHub (https://github.com/org/repo). La calcula context.mjs; no la escribas a mano.",
              "type": "string",
              "pattern": "^https://github\\.com/[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$"
            },
            "published": {
              "description": "true si el commit ya está en alguna rama remota (los enlaces a GitHub funcionarán). Lo calcula context.mjs.",
              "type": "boolean"
            }
          }
        },
        "stats": {
          "type": "object",
          "additionalProperties": false,
          "required": ["filesChanged", "additions", "deletions"],
          "properties": {
            "filesChanged": { "type": "integer", "minimum": 0 },
            "additions": { "type": "integer", "minimum": 0 },
            "deletions": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },

    "evidence": {
      "description": "Fragmento verificable que respalda una afirmación. El snippet es obligatorio porque el HTML no puede leer el repositorio.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "file", "snippet"],
      "properties": {
        "kind": { "enum": ["code", "diff", "spec", "test", "config", "doc"] },
        "file": { "$ref": "#/$defs/relativePath" },
        "lines": {
          "description": "Rango de líneas del snippet en el archivo (en un diff, en la versión nueva).",
          "type": "object",
          "additionalProperties": false,
          "required": ["start", "end"],
          "properties": {
            "start": { "type": "integer", "minimum": 1 },
            "end": { "type": "integer", "minimum": 1 }
          }
        },
        "snippet": {
          "description": "Máximo 60 líneas (se comprueba en la validación semántica).",
          "type": "string",
          "pattern": "\\S",
          "maxLength": 4000
        },
        "note": { "$ref": "#/$defs/shortText" }
      }
    },
    "evidenceList": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": { "$ref": "#/$defs/evidence" }
    },

    "focus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "priority", "title", "why", "evidence"],
      "properties": {
        "id": { "type": "string", "pattern": "^F[0-9]+$" },
        "type": {
          "description": "change: cambio relevante · decision: decisión arquitectónica · risk: riesgo potencial · requirement-gap: desviación o hueco frente a requisitos · test-gap: comportamiento sin pruebas.",
          "enum": ["change", "decision", "risk", "requirement-gap", "test-gap"]
        },
        "priority": {
          "description": "Orientativa; no es una garantía.",
          "enum": ["high", "medium", "low"]
        },
        "title": { "$ref": "#/$defs/label" },
        "why": {
          "description": "Por qué conviene que lo mire un humano.",
          "$ref": "#/$defs/text"
        },
        "evidence": { "$ref": "#/$defs/evidenceList" }
      }
    },

    "flashcard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "focusIds", "front", "title", "back", "evidence"],
      "properties": {
        "id": { "type": "string", "pattern": "^C[0-9]+$" },
        "focusIds": { "$ref": "#/$defs/focusRefs" },
        "front": { "$ref": "#/$defs/shortText" },
        "title": {
          "description": "Titular de la respuesta, en texto plano y sin formato (se ve en la cara trasera).",
          "$ref": "#/$defs/label"
        },
        "back": { "$ref": "#/$defs/text" },
        "evidence": {
          "description": "La tarjeta solo tiene espacio para 1–2 fragmentos.",
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": { "$ref": "#/$defs/evidence" }
        }
      }
    },

    "quizItem": {
      "description": "single: 2–6 opciones y una correcta (incluye verdadero/falso como dos opciones) · multiple: 3–6 opciones y 2 o más correctas, sin que lo sean todas. En multiple la interfaz pide seleccionar exactamente tantas como correctas haya.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "focusIds", "kind", "title", "prompt", "options", "correct", "explanation", "evidence"],
      "properties": {
        "id": { "type": "string", "pattern": "^Q[0-9]+$" },
        "focusIds": { "$ref": "#/$defs/focusRefs" },
        "kind": { "enum": ["single", "multiple"] },
        "title": { "$ref": "#/$defs/label" },
        "prompt": { "$ref": "#/$defs/text" },
        "options": {
          "type": "array",
          "minItems": 2,
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "text"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-f]$" },
              "text": { "$ref": "#/$defs/shortText" },
              "detail": {
                "description": "Texto secundario bajo el título de la opción. Se ve ANTES de responder: debe ser neutro y no desvelar si la opción es correcta.",
                "$ref": "#/$defs/text"
              },
              "why": {
                "description": "Por qué la opción es incorrecta. Obligatoria en las opciones incorrectas (se comprueba en la validación semántica). Se muestra tras confirmar, si el humano la ha elegido.",
                "$ref": "#/$defs/text"
              }
            }
          }
        },
        "correct": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-f]$" }
        },
        "explanation": {
          "description": "Por qué la respuesta correcta lo es. Se muestra al acertar.",
          "$ref": "#/$defs/longText"
        },
        "evidence": { "$ref": "#/$defs/evidenceList" }
      }
    },

    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "focusIds", "title", "situation", "prompt", "evidence"],
      "properties": {
        "id": { "type": "string", "pattern": "^S[0-9]+$" },
        "focusIds": { "$ref": "#/$defs/focusRefs" },
        "title": { "$ref": "#/$defs/label" },
        "situation": {
          "description": "Contexto del «¿qué pasaría si…?». El humano responde por escrito y copia las respuestas al chat para que el agente las evalúe: el HTML no muestra ninguna respuesta de referencia.",
          "$ref": "#/$defs/text"
        },
        "prompt": { "$ref": "#/$defs/shortText" },
        "evidence": { "$ref": "#/$defs/evidenceList" }
      }
    },

    "codeRef": {
      "description": "Dónde está algo en el repositorio. Sin snippet: se comprueba que el archivo existe y que las líneas caben.",
      "type": "object",
      "additionalProperties": false,
      "required": ["file"],
      "properties": {
        "file": { "$ref": "#/$defs/relativePath" },
        "lines": { "$ref": "#/$defs/lineRange" }
      }
    },
    "codeRefWithSnippet": {
      "description": "Como codeRef, con un fragmento de código opcional (máximo 12 líneas). Si hay snippet, debe coincidir con el archivo.",
      "type": "object",
      "additionalProperties": false,
      "required": ["file"],
      "properties": {
        "file": { "$ref": "#/$defs/relativePath" },
        "lines": { "$ref": "#/$defs/lineRange" },
        "snippet": { "type": "string", "pattern": "\\S", "maxLength": 1200 }
      }
    },
    "lineRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "integer", "minimum": 1 },
        "end": { "type": "integer", "minimum": 1 }
      }
    },
    "optionalFocusRefs": {
      "type": "array",
      "minItems": 0,
      "maxItems": 3,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^F[0-9]+$" }
    },

    "study": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chronicle", "map", "teachings"],
      "properties": {
        "chronicle": { "$ref": "#/$defs/chronicle" },
        "map": { "$ref": "#/$defs/knowledgeMap" },
        "teachings": {
          "description": "Píldoras del maestro: lo que alguien debería recordar de este cambio.",
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": { "$ref": "#/$defs/teaching" }
        }
      }
    },
    "chronicle": {
      "description": "La crónica: qué se hizo y para qué, en un párrafo corto.",
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "text"],
      "properties": {
        "title": { "$ref": "#/$defs/label" },
        "text": { "$ref": "#/$defs/text" }
      }
    },
    "knowledgeMap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["flow", "components", "models", "decisions", "edgeCases", "tests"],
      "properties": {
        "flow": {
          "description": "Recorrido de la ejecución, de la entrada a la salida.",
          "type": "array", "minItems": 2, "maxItems": 8,
          "items": { "$ref": "#/$defs/flowStep" }
        },
        "components": {
          "type": "array", "minItems": 1, "maxItems": 8,
          "items": { "$ref": "#/$defs/component" }
        },
        "models": {
          "type": "array", "minItems": 0, "maxItems": 8,
          "items": { "$ref": "#/$defs/dataModel" }
        },
        "decisions": {
          "type": "array", "minItems": 0, "maxItems": 6,
          "items": { "$ref": "#/$defs/studyNote" }
        },
        "edgeCases": {
          "type": "array", "minItems": 0, "maxItems": 6,
          "items": { "$ref": "#/$defs/studyNote" }
        },
        "tests": {
          "type": "array", "minItems": 0, "maxItems": 8,
          "items": { "$ref": "#/$defs/testItem" }
        }
      }
    },
    "flowStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "detail"],
      "properties": {
        "label": { "type": "string", "pattern": "\\S", "maxLength": 60 },
        "detail": { "type": "string", "pattern": "\\S", "maxLength": 160 },
        "ref": { "$ref": "#/$defs/codeRef" }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "role", "detail"],
      "properties": {
        "name": { "type": "string", "pattern": "\\S", "maxLength": 80 },
        "role": { "type": "string", "pattern": "\\S", "maxLength": 40 },
        "detail": { "$ref": "#/$defs/shortText" },
        "ref": { "$ref": "#/$defs/codeRef" }
      }
    },
    "dataModel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "role", "detail"],
      "properties": {
        "name": { "type": "string", "pattern": "\\S", "maxLength": 80 },
        "role": { "type": "string", "pattern": "\\S", "maxLength": 40 },
        "detail": { "$ref": "#/$defs/shortText" },
        "fields": {
          "type": "array", "minItems": 0, "maxItems": 8,
          "items": { "type": "string", "pattern": "\\S", "maxLength": 60 }
        },
        "ref": { "$ref": "#/$defs/codeRef" }
      }
    },
    "studyNote": {
      "description": "Decisión o caso límite: título y una frase.",
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "detail"],
      "properties": {
        "title": { "$ref": "#/$defs/label" },
        "detail": { "$ref": "#/$defs/shortText" },
        "focusIds": { "$ref": "#/$defs/optionalFocusRefs" },
        "ref": { "$ref": "#/$defs/codeRefWithSnippet" }
      }
    },
    "testItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "detail"],
      "properties": {
        "name": {
          "description": "Clase, archivo o función de test.",
          "type": "string", "pattern": "\\S", "maxLength": 100
        },
        "detail": { "$ref": "#/$defs/shortText" },
        "cases": { "type": "integer", "minimum": 1, "maximum": 999 },
        "ref": { "$ref": "#/$defs/codeRef" }
      }
    },
    "teaching": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "text"],
      "properties": {
        "title": { "$ref": "#/$defs/label" },
        "text": { "$ref": "#/$defs/text" },
        "focusIds": { "$ref": "#/$defs/optionalFocusRefs" },
        "ref": { "$ref": "#/$defs/codeRefWithSnippet" }
      }
    }
  }
}
