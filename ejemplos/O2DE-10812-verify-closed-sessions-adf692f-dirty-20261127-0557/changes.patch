diff --git a/get_external_token_info_spec.json b/get_external_token_info_spec.json
new file mode 100644
index 0000000..8d8a7fc
--- /dev/null
+++ b/get_external_token_info_spec.json
@@ -0,0 +1,370 @@
+{
+  "openapi": "3.0.3",
+  "info": {
+    "title": "LoginAuthAgent — External Token Information",
+    "version": "1.0.0-draft",
+    "description": "Proposed API for retrieving the external refresh token and external user identifier associated with the authenticated caller's session."
+  },
+  "servers": [
+    {
+      "url": "https://api-cert0-br.mytelco.io",
+      "description": "Brazil CERT0"
+    },
+    {
+      "url": "https://api-cert1-br.mytelco.io",
+      "description": "Brazil CERT1"
+    },
+    {
+      "url": "https://api-cert2-br.mytelco.io",
+      "description": "Brazil CERT2"
+    },
+    {
+      "url": "https://api-cert3-br.mytelco.io",
+      "description": "Brazil CERT3"
+    },
+    {
+      "url": "https://api-next-br.mytelco.io",
+      "description": "Brazil NEXT"
+    },
+    {
+      "url": "https://api-br.mytelco.io",
+      "description": "Brazil PROD"
+    }
+  ],
+  "tags": [
+    { "name": "LoginAuthAgent" }
+  ],
+  "paths": {
+    "/": {
+      "post": {
+        "tags": ["LoginAuthAgent"],
+        "operationId": "getExternalTokenInfo",
+        "summary": "Get external token information",
+        "description": "Invokes LoginAuthAgent.1.getExternalTokenInfo using JSON-RPC 2.0.\n\nNo method parameters are required. The session is resolved from the authenticated request context.\n\nThe response contains sensitive credentials and must not be logged or included in analytics or traces.",
+        "security": [
+          { "bearerAuth": [] }
+        ],
+        "parameters": [
+          {
+            "name": "X-Tuenti-ApiContext",
+            "in": "header",
+            "required": true,
+            "description": "API context encoded as a JSON string, following the existing gateway convention. Header values do not replace bearer authentication.",
+            "schema": { "type": "string" },
+            "example": "{\"installationId\":\"e3b0b92755131b81a3b5e45400d4f67d\",\"appBrand\":\"VivoBR\",\"appVersion\":\"26.5.1\",\"globalId\":1314260000}"
+          }
+        ],
+        "requestBody": {
+          "required": true,
+          "content": {
+            "application/json": {
+              "schema": {
+                "$ref": "#/components/schemas/GetExternalTokenInfoRequest"
+              },
+              "example": {
+                "jsonrpc": "2.0",
+                "id": 1,
+                "method": "LoginAuthAgent.1.getExternalTokenInfo",
+                "params": {}
+              }
+            }
+          }
+        },
+        "responses": {
+          "200": {
+            "description": "JSON-RPC success or error response. Clients must inspect result or error to determine the outcome. HTTP status mapping for RPC errors is subject to confirmation.",
+            "content": {
+              "application/json": {
+                "schema": {
+                  "oneOf": [
+                    { "$ref": "#/components/schemas/GetExternalTokenInfoResponse" },
+                    { "$ref": "#/components/schemas/JsonRpcErrorResponse" }
+                  ]
+                },
+                "examples": {
+                  "success": {
+                    "summary": "External token information retrieved",
+                    "value": {
+                      "jsonrpc": "2.0",
+                      "id": 1,
+                      "result": {
+                        "refresh_token": "<EXTERNAL_REFRESH_TOKEN>",
+                        "user_id": "external-user-123"
+                      }
+                    }
+                  },
+                  "tokenNotFound": {
+                    "summary": "Token information unavailable (proposed mapping)",
+                    "value": {
+                      "jsonrpc": "2.0",
+                      "id": 1,
+                      "error": {
+                        "code": 105,
+                        "message": "Token information not found"
+                      }
+                    }
+                  }
+                }
+              }
+            }
+          },
+          "default": {
+            "description": "Gateway or transport-level failure, including authentication or authorization rejection. HTTP status codes and response bodies are subject to confirmation."
+          }
+        }
+      }
+    },
+    "/token": {
+      "post": {
+        "tags": ["LoginAuthAgent"],
+        "operationId": "token",
+        "summary": "Exchange a legacy external refresh token for an access token",
+        "description": "Legacy OAuth-style token endpoint used by the mobile app to exchange an external refresh token for a bearer access token.\n\nClient authentication is optional on the first attempt: the app sends the request with no Authorization header. If the server responds with 401 and error 'invalid_client', the app resends the identical body with 'Authorization: Basic bGVnYWN5Og==' (base64 of 'legacy:', the fixed legacy client credentials with an empty password). A 401 with error 'invalid_grant' means the refresh token itself is invalid or expired and must not be retried with different credentials.\n\nNote: the 'invalid_client' retry trigger follows the RFC 6749 section 5.2 convention and has not been directly observed in captured traffic; only the anonymous success case and the invalid_grant error case have been confirmed. OpenAPI cannot express this conditional retry natively, so the sequence is documented here instead.",
+        "security": [
+          {},
+          { "legacyBasicAuth": [] }
+        ],
+        "parameters": [
+          {
+            "name": "User-Agent",
+            "in": "header",
