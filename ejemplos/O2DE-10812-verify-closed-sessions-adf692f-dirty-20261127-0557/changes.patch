+package com.tuenti.services.auth.sessions.boundaries.service
+
+import com.tuenti.platform.kotlintest.junit5.TKotlinIntegrationTest
+import com.tuenti.platform.kotlintest.junit5.nio.NioTestExtension
+import com.tuenti.platform.kotlintest.junit5.nio.NioTestScope
+import com.tuenti.platform.test.integration.NativeFunctionsWithOverride
+import com.tuenti.platform.test.system.NativeFunctionsMock
+import com.tuenti.services.auth.sessions.boundaries.service.v2.Sessions
+import com.tuenti.services.auth.sessions.boundaries.service.v2.dto.UserSession
+import com.tuenti.services.auth.sessions.domain.SessionRepository
+import com.tuenti.services.auth.sessions.domain.model.ExternalAccessToken
+import com.tuenti.services.auth.sessions.domain.model.ExternalRefreshToken
+import com.tuenti.services.auth.sessions.domain.model.SessionCreation
+import org.junit.jupiter.api.BeforeEach
+import org.junit.jupiter.api.Test
+import org.junit.jupiter.api.extension.ExtendWith
+import java.time.Instant
+import kotlin.random.Random
+import kotlin.test.assertEquals
+
+@ExtendWith(NioTestExtension::class)
+class SessionsServiceImplIntegrationTest : TKotlinIntegrationTest() {
+
+    private val sessions: Sessions by inject()
+    private val sessionRepository: SessionRepository by inject()
+    private val nativeFunctionsWithOverride: NativeFunctionsWithOverride by inject()
+    private val nativeFunctionsMock = NativeFunctionsMock()
+
+    @BeforeEach
+    fun setup() {
+        nativeFunctionsWithOverride.setOverrideImplementation(nativeFunctionsMock)
+        nativeFunctionsMock.setCurrentTime(SOME_CREATED_AT.epochSecond)
+    }
+
+    @Test
+    fun NioTestScope.`getAllUserSessions returns all the sessions of the user`() = request {
+        val firstSessionId = sessionRepository.create(aSessionCreation(USER_WITH_SESSIONS, "installation-1"))
+        val secondSessionId = sessionRepository.create(aSessionCreation(USER_WITH_SESSIONS, "installation-2"))
+
+        val userSessions = sessions.getAllUserSessions(USER_WITH_SESSIONS)
+
+        assertEquals(
+            setOf(
+                UserSession(firstSessionId.toString(), "installation-1", SOME_CREATED_AT, SOME_CREATED_AT),
+                UserSession(secondSessionId.toString(), "installation-2", SOME_CREATED_AT, SOME_CREATED_AT),
+            ),
+            userSessions.toSet(),
+        )
+    }
+
+    @Test
+    fun NioTestScope.`getAllUserSessions does not return sessions of other users`() = request {
+        sessionRepository.create(aSessionCreation(OTHER_USER, "other-installation"))
+
+        val userSessions = sessions.getAllUserSessions(USER_WITHOUT_SESSIONS)
+
+        assertEquals(emptyList(), userSessions)
+    }
+
+    companion object {
+        private val USER_WITH_SESSIONS = Random.nextLong(1_000_000L, Int.MAX_VALUE.toLong())
+        private val USER_WITHOUT_SESSIONS = USER_WITH_SESSIONS + 1
+        private val OTHER_USER = USER_WITH_SESSIONS + 2
+
+        private val SOME_CREATED_AT = Instant.ofEpochSecond(1_700_000_000L)
+
+        private fun aSessionCreation(userId: Long, installationId: String) = SessionCreation(
+            userId = userId,
+            installationId = installationId,
+            flowId = "some-flow-id",
+            externalSession = SessionCreation.ExternalSession(
+                accessToken = ExternalAccessToken(
+                    value = "some-access-token",
+                    expiresAt = Instant.ofEpochSecond(1_700_003_600L),
+                    flowId = "some-flow-id",
+                ),
+                expiresIn = 3600,
+                refreshToken = ExternalRefreshToken("some-refresh-token", SOME_CREATED_AT),
+                idToken = null,
+            )
+        )
+    }
+}
